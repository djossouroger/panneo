{
  "expo": {
    "name": "Pannéo",
    "slug": "panneo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.panneo.app"
    },
    "android": {
      "package": "com.panneo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "panneo",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Pannéo accède à vos photos pour les pièces d'identité, selfies et photos de profil.",
          "cameraPermission": "Pannéo utilise l'appareil photo pour les photos de profil et le selfie de vérification d'identité.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
