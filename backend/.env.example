# =====================================================================
# Pannéo — Exemple de configuration Laravel (backend)
# Copiez ce fichier vers `.env` puis ajustez les valeurs.
# Production (Railway) : voir docs/RAILWAY_VARIABLES.md
# =====================================================================

APP_NAME="Pannéo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# En production : APP_ENV=production, APP_DEBUG=false et
# APP_URL=https://<votre-domaine-railway> (obligatoire pour les URLs publiques /storage).

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logs — en production sur Railway, préférez : LOG_CHANNEL=stderr
# (Railway capture stdout/stderr ; les fichiers storage/logs ne sont pas persistants).
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------
# Base de données — PostgreSQL (développement et production)
# ---------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=panneo
DB_USERNAME=postgres
DB_PASSWORD=
# Railway : soit définir les 5 variables ci-dessus (${{Postgres.PG...}}),
# soit une seule variable URL. DB_URL fonctionne tel quel avec Laravel
# (le sslmode=require de Railway est appliqué automatiquement) :
# DB_URL=${{Postgres.DATABASE_URL}}
DB_SSLMODE=prefer

# ---------------------------------------------------------------------
# Stockage persistant — fichiers uploadés (photos, pièces d'identité)
# ---------------------------------------------------------------------
# Par défaut : storage/app (local). Sur Railway, montez un Volume à un
# chemin ABSOLU (ex: /data) puis : PERSISTENT_STORAGE_PATH=/data
# Le disque `local` (documents privés) et le disque `public` (photos,
# portfolio) pointent alors vers /data/private et /data/public.
# PERSISTENT_STORAGE_PATH=/data

# Livraison des OTP : log (développement) | mail (SMTP) | sms (log)
OTP_DELIVERY=log

# ---------------------------------------------------------------------
# Compte administrateur (créé par `php artisan db:seed`)
# ---------------------------------------------------------------------
# En production, ces variables sont OBLIGATOIRES et DOIVENT contenir un
# mot de passe fort (aucune valeur par défaut ne doit rester active).
# Alternative : `php artisan admin:create --email=... --password=...`.
ADMIN_NAME="Pannéo Admin"
ADMIN_EMAIL=admin@panneo.test
ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En production derrière le proxy HTTPS de Railway, activez le cookie sécurisé :
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ---------------------------------------------------------------------
# Envoi des e-mails (OTP, réinitialisation, vérification)
# ---------------------------------------------------------------------
# LOCAL : MAIL_MAILER=log pour déboguer (les codes sont loggés), ou smtp
# avec Gmail (port 587, MAIL_USERNAME = adresse complète du compte,
# MAIL_PASSWORD = "Mot de passe d'application" Gmail).
#
# PRODUCTION (Railway) : le SMTP sortant (ports 25/465/587/2525) est
# BLOQUÉ sur les plans gratuits/Hobby. Utilisez un service d'e-mail en
# API HTTPS. Configuré ici : SendGrid (transport custom, API HTTPS,
# ~100 e-mails/jour en gratuit) :
#   MAIL_MAILER=sendgrid
#   SENDGRID_API_KEY=SG.<votre-cle>
# Voir docs/RAILWAY_VARIABLES.md.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SENDGRID_API_KEY=

VITE_APP_NAME="${APP_NAME}"
